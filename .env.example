# Copia este archivo como .env y completa los valores. .env NO se sube a GitHub.
# En Streamlit Cloud, estos mismos nombres van en Settings > Secrets.

# Clave de Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Modelo Flash vigente (se verifica en la documentación de Gemini al implementar ai/)
GEMINI_MODEL=
